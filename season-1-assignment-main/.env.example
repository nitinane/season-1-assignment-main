# HireFlow AI - Environment Variables Template
# Copy this file to '.env' and populate with your credentials.

# Supabase Configurations
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq API Key for LLM Agents
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here
VITE_GROQ_API_KEYS=key1,key2,key3,key4,key5
GROQ_API_KEYS=key1,key2,key3,key4,key5


# Telegram Notification Configurations (Agent 9)
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Drive Configuration (Agent 3)
VITE_DRIVE_RESUME_FOLDER_ID=your_google_drive_folder_id_here
DRIVE_RESUME_FOLDER_ID=your_google_drive_folder_id_here


# --- Gnani AI (server-side only, never prefix with VITE_) ---
GNANI_API_KEY=your_gnani_api_key
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GROQ_API_KEYS=key1,key2
